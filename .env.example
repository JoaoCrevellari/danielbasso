# Copie para .env e preencha. Nunca commite o .env.

# --- Públicas (vão para o bundle do navegador; variáveis de BUILD no Workers Builds) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Lidas pelo servidor em runtime (Variables do Worker) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Segredo (Secrets do Worker; nunca com prefixo VITE_) ---
# Só o módulo "Usuários" do admin usa (convidar pessoas). Sem ele, o resto funciona.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail de aviso de novos leads (Resend) — opcional ---
RESEND_API_KEY=
EMAIL_FROM="Site Daniel Basso <nao-responda@danielbasso.com.br>"
LEAD_NOTIFY_TO=
