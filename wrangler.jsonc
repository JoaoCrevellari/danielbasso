// Configuração do Worker na Cloudflare. O Nitro (preset cloudflare-module) completa
// main/assets no build e gera .output/server/wrangler.json, que é o usado pelo deploy.
//
// Variáveis e segredos NÃO ficam aqui: são cadastrados no painel do Worker.
// `keep_vars` impede que um deploy apague o que está no painel.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danielbasso",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": { "enabled": true },
  "workers_dev": true,
  // Formulários: 6 envios por minuto por IP. Analytics: 120 lotes por minuto por IP.
  "ratelimits": [
    { "name": "LIMITE_FORMULARIO", "namespace_id": "2001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LIMITE_ANALYTICS", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
  ],
}
